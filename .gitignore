# Ignore Python cache
__pycache__/
*.py[cod]

# Ignore editor VSCode/VSCodium settings
.vscode/
.history/
*.code-workspace

# Ignore any .snakemake folders at any level
**/.snakemake/
**/intermediate_files/

# Ignore images that can be generated from the code
*.png
*.gif
*.log
.pickled*
.validated*
**/.gif_ymax
**/.expanded*
**/.iteration_nr*
**/.species_steady_state_concentrations.json
data/**/combo*
data/**/.convergence_logger.csv
data/**/combined*/
*data*/**/.

# Ignore all pdf files
*.pdf

examples/simple_decay_without_inner_boundaries/
examples/simple_decay_with_one_inner_boundary/
#examples/**/combined*/

!examples/simple_decay_with_two_inner_boundaries/combined_000001/newton_iterations.gif

notes/*