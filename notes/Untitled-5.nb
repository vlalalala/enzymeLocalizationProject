Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "u"}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diff", "=", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P12", "=", "2.0"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"permeability", " ", "at", " ", "x"}], "=", "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P2ext", "=", "1.0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"permeability", " ", "at", " ", "x"}], "=", "2"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uExt", "=", "1.0"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"Interval", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "2"}], "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", "x", "]"}], ",", 
      RowBox[{"{", "x", "}"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"uComp", "=", 
    RowBox[{"MassTransportPDEComponent", "[", 
     RowBox[{"vars", ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<DiffusionCoefficient\>\"", "->", "diff"}], ",", 
        RowBox[{"\"\<Reaction\>\"", "->", 
         RowBox[{
          RowBox[{"-", "k"}], "*", 
          RowBox[{"u", "[", "x", "]"}]}]}]}], "|>"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bcs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MassImpermeableBoundaryValue", "[", 
       RowBox[{
        RowBox[{"x", "==", "0"}], ",", "vars", ",", 
        RowBox[{"<|", "|>"}], ",", 
        RowBox[{"<|", "|>"}]}], "]"}], ",", 
      RowBox[{"MassTransferValue", "[", 
       RowBox[{
        RowBox[{"x", "==", "1"}], ",", "vars", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<MassTransferCoefficient\>\"", "->", "P12"}], ",", 
          RowBox[{"\"\<AmbientConcentration\>\"", "->", "Automatic"}]}], 
         "|>"}], ",", 
        RowBox[{"<|", "|>"}]}], "]"}], ",", 
      RowBox[{"MassTransferValue", "[", 
       RowBox[{
        RowBox[{"x", "==", "2"}], ",", "vars", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<MassTransferCoefficient\>\"", "->", "P2ext"}], ",", 
          RowBox[{"\"\<AmbientConcentration\>\"", "->", "uExt"}]}], "|>"}], ",", 
        RowBox[{"<|", "|>"}]}], "]"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"uComp", "==", "0"}], ",", "bcs"}], "}"}], ",", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"<", 
         RowBox[{
          RowBox[{"--", "boundary"}], " ", "conditions", " ", "are", " ", 
          "listed", " ", "separately"}]}], ",", 
        RowBox[{"not", " ", "as", " ", "equations"}]}], "*)"}], 
      RowBox[{"u", "[", "x", "]"}], ",", 
      RowBox[{
       RowBox[{"{", "x", "}"}], "\[Element]", "\[CapitalOmega]"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<FiniteElement\>\"", ",", 
         RowBox[{"\"\<MeshOptions\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<MaxCellMeasure\>\"", "->", "0.02"}], "}"}]}]}], 
        "}"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"sol", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Single-species steady-state\>\""}], ",", 
