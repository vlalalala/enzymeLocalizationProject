  RowBox[{"(*", 
   RowBox[{
   "Dependent", " ", "variables", " ", "and", " ", "spatial", " ", 
    "variable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"u", "[", "x", "]"}], ",", 
        RowBox[{"v", "[", "x", "]"}]}], "}"}], ",", 
      RowBox[{"{", "x", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PDE", " ", "definitions"}], "\[LongDash]", 
    RowBox[{
     RowBox[{"steady", " ", 
      RowBox[{"state", ":", 
       RowBox[{"\[PartialD]", "t"}]}]}], "=", "0"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uComp", "=", 
   RowBox[{"MassTransportPDEComponent", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", "x", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<DiffusionCoefficient\>\"", "->", "diff"}], ",", 
