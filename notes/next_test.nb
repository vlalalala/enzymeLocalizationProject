          RowBox[{"k", "*", 
           RowBox[{"u", "[", "x", "]"}]}], ")"}]}]}], "|>"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Boundary", " ", "condition", " ", "associations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bcList", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Region\>\"", "->", 
         RowBox[{"(", 
          RowBox[{"x", "==", "0"}], ")"}]}], ",", 
