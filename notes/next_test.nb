          RowBox[{"-", "k"}], " ", "*", " ", 
          RowBox[{"u", "[", "x", "]"}]}], ")"}]}]}], "|>"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vComp", "=", 
    RowBox[{"MassTransportPDEComponent", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", "[", "x", "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<DiffusionCoefficient\>\"", "->", "diff"}], ",", 
