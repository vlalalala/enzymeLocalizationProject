Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Steady", "-", 
    RowBox[{"State", " ", "1", "D", " ", "Diffusion"}], "-", 
    RowBox[{"Reaction", " ", "Example"}]}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Load", " ", "the", " ", "PDE", " ", "component", " ", "for", " ", "mass", 
    " ", "transport"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Needs", "[", "\"\<PDEModels`\>\"", "]"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "optional", " ", "depending", " ", "on", " ", "your", " ", "WL", " ", 
     "version"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "PDE", " ", "component"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pde", "=", 
     RowBox[{"MassTransportPDEComponent", "[", 
      RowBox[{
       RowBox[{"c", "[", "x", "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "concentration", " ", "depends", " ", "only", " ", "on", " ", "x"}], 
        "*)"}], "x", ",", 
       RowBox[{"(*", 
        RowBox[{"spatial", " ", "variable"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D", "->", "1"}], ",", 
         RowBox[{"k", "->", "0.5"}]}], "}"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"diffusion", " ", "coefficient", " ", "and", " ", "first"}], "-", 
        RowBox[{"order", " ", "reaction", " ", "rate"}]}], "*)"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Boundary", " ", 
      RowBox[{"conditions", ":", 
       RowBox[{"Dirichlet", " ", "at", " ", "x"}]}]}], "=", 
     RowBox[{
      RowBox[{"0", " ", "and", " ", "x"}], "=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bcs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"c", "[", "1", "]"}], "==", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Solve", " ", "the", " ", "steady"}], "-", 
     RowBox[{"state", " ", "PDE", " ", "numerically"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pde", "==", "0"}], ",", "bcs"}], "}"}], ",", "c", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "concentration", " ", "profile"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"sol", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotLabels", "->", "\"\<Concentration\>\""}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<c(x)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9699539924614563`*^9, 3.969954029619833*^9}},
 CellLabel->
  "In[781]:=",ExpressionUUID->"e37cbfaf-69ef-674c-b60e-bcdd54beb8f7"],

