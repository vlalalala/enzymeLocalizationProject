    RowBox[{
     RowBox[{"x", "==", "1"}], ",", "vars", ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<MassTransferCoefficient\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<AmbientConcentration\>\"", "->", "4"}]}], "|>"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";", 
  RowBox[{"eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"MassTransportPDEComponent", "[", 
      RowBox[{"vars", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<DiffusionCoefficient\>\"", "->", "0.025"}], ",", 
         RowBox[{"\"\<Reaction\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "*", 
            RowBox[{"c", "[", "x", "]"}]}], ")"}]}]}], "|>"}]}], "]"}], "==", 
