 RowBox[{
  RowBox[{"cExt", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P2ext", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "[", "x", "]"}], ",", 
     RowBox[{"{", "x", "}"}]}], "}"}]}], ";"}], "\n", 
