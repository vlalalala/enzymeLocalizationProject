        RowBox[{"MassTransferValue", "[", 
         RowBox[{
          RowBox[{"x", "==", "2"}], ",", "vars", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<MassTransferCoefficient\>\"", "->", "P2ext"}], ",", 
            RowBox[{"\"\<AmbientConcentration\>\"", "->", "cExt"}]}], "|>"}], 
          ",", 
          RowBox[{"<|", "|>"}]}], "]"}]}], "}"}], ",", 
