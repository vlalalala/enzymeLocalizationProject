  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{"Interval", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ";", 
  RowBox[{"gammaleft", "=", 
   RowBox[{"MassImpermeableBoundaryValue", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "vars", ",", 
